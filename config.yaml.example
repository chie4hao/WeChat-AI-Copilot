# 你的微信昵称，导入聊天记录时自动识别哪条消息是你发的
my_name: "你的微信昵称"

gemini:
  api_key: "YOUR_GEMINI_API_KEY"
  model: "gemini-2.0-flash"
  candidate_count: 3
  temperature: 0.9
  stream: true   # true=流式（逐字显示），false=等待完整结果后显示

# Claude Code 配置（可选）：走 Claude Max 订阅额度，不产生 API 费用，启用后优先级最高
# oauth_token 在本地电脑的 Claude Code 里运行 `claude setup-token` 生成（sk-ant-oat01- 开头）
# claude_code:
#   enabled: true
#   oauth_token: "sk-ant-oat01-..."
#   model: "claude-opus-5"   # 或 claude-fable-5-1（最强但更慢、额度消耗高）/ claude-sonnet-5（更省额度）
#   token_created_at: "2026-01-01"   # token 生成日期，用于一年后的到期提醒（换 token 时自动更新）
#   candidate_count: 3

# Claude 配置（可选）：填写后自动切换为 Claude 提供商，Gemini 配置将被忽略
# 推荐 claude-opus-5（$5/$25，本场景性价比最高）
# claude-fable-5-1 最强但 $10/$50 且更慢；claude-sonnet-5（$2/$10）更快更省
# base_url 填反代地址时走订阅额度而非 API 计费（如 clewdr 的 /code 端点，Anthropic 原生格式
# 透传，缓存/thinking/结构化输出照常生效）。末尾不要带 /v1，SDK 会自动追加；
# 用 clewdr 时 api_key 填它的访问密码
# claude:
#   api_key: "YOUR_ANTHROPIC_API_KEY"
#   base_url: "http://127.0.0.1:8484/code"
#   model: "claude-opus-5"
#   candidate_count: 3
#   effort: "high"   # 思考深度 low/medium/high/xhigh/max：越高思考越深、越慢越贵、质量越好；Haiku 不支持（自动忽略）

server:
  port: 3000
  # 本地端上报的认证 token（本地端 config.yaml 的 vps.secret 要与这里一致）
  sync_secret: "your-secret-token"
  # 填写后自动启用 HTTPS（使用已有证书，无需 Nginx/Caddy）
  # certPath: /root/cert/example.com/fullchain.pem
  # keyPath:  /root/cert/example.com/privkey.pem
  # IP 白名单（可选，限制哪些 IP 可以访问）
  # allowedIPs:
  #   - "127.0.0.1"
  # Web Push 推送通知（可选）
  # 生成方法：npx web-push generate-vapid-keys
  # vapid_subject: "mailto:you@example.com"
  # vapid_public_key: "BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxA"
  # vapid_private_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 过滤名单（黑名单）：昵称包含以下任意关键词时，不触发 AI 生成（适合屏蔽通知类账号）
# skip_names:
#   - "美团"
#   - "麦当劳"
#   - "招商银行"

# 只触发名单（白名单）：填写后只有昵称包含这些关键词的人收到消息才自动触发 AI，
# 其他人只保存消息记录。留空则对所有人触发（过滤名单仍优先）。手动获取建议不受限制。
# only_names:
#   - "小A"
#   - "重要客户"

# 系统 prompt：写你的人设和回复要求
# 聊天记录由程序自动从数据库读取并拼入，不需要在这里写
prompt: |
  你是我的聊天参谋，帮我想回复思路。

  【关于我】
  （在这里填写你的基本信息，例如：年龄、职业、性格、爱好等）
  示例：28岁，互联网从业者，性格内敛，喜欢户外运动。

  【回复要求】
  - 用自然的方式给我分析当前对话的情况、建议方向和理由，不需要按固定格式，像朋友聊天一样说
  - 然后给出若干条候选回复，长短根据情况判断，不强制字数限制
  - 候选回复语气像正常人发消息，自然真实
  - 绝对不能油腻、不能堆感叹号
  - 如果当前对话不需要回复，直接说明原因和建议

# 拼给 AI 的消息时间与"当前时间"所用的时区（IANA 名称），与 VPS 所在时区无关
timezone: "Asia/Shanghai"

# 本地端超过这么多分钟没有心跳，主页状态卡标红并推送一次提醒
bridge_offline_minutes: 10
